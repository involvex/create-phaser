		"typecheck": "bun check"
	},
	"prettier": "@involvex/prettier-config",
	"dependencies": {
		"@clack/prompts": "^1.8.1",
		"picocolors": "^1.1.1"
	},
	"devDependencies": {
		"@involvex/prettier-config": "^0.0.6",
		"@types/bun": "^1.4.4",
		"@types/node": "^26.6.5",
		"prettier": "^3.9.10"
	},
	"engines": {
		"node": ">=20"
	}
}
