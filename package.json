{
	"name": "@involvex/create-phaser",
	"version": "0.1.0",
	"description": "Scaffold a TypeScript Phaser game project. Interactive game-style picker with built-in templates.",
	"keywords": [
		"phaser",
		"phaser4",
		"typescript",
		"vite",
		"game",
		"create",
		"scaffold",
		"template",
		"cli"
	],
	"homepage": "https://github.com/involvex/create-phaser#readme",
	"bugs": {
		"url": "https://github.com/involvex/create-phaser/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/involvex/create-phaser.git"
	},
	"license": "MIT",
	"author": "involvex",
	"type": "module",
	"bin": {
		"create-phaser": "dist/cli.mjs"
	},
	"files": [
